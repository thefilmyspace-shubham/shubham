# Supabase (Project Settings -> API). Create the project with the new
# Science Academy email, region Mumbai (ap-south-1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in emails and notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login codes: "email" (default, free, same as the TFS app) or "sms".
OTP_CHANNEL=email

# Academy Gmail for login codes and bills (Google Account -> Security ->
# 2-Step Verification -> App passwords). Leave empty in development: the
# code is then printed in the server log and shown on the login screen.
SMTP_USER=
SMTP_PASSWORD=
# Optional: MAIL_FROM="Science Academy <academy@gmail.com>"

# Only for OTP_CHANNEL=sms: MSG91 with a DLT registered sender and an approved
# OTP template whose text contains ##otp##.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Claude API key (console.anthropic.com -> API keys): AI marksheet check and AI assistant.
ANTHROPIC_API_KEY=

# Optional instead of Gmail for bills: Resend (resend.com), sender on a verified domain.
RESEND_API_KEY=
BILL_FROM_EMAIL=

# Random long string; Vercel sends it with every cron call.
CRON_SECRET=

# Printed on every bill. Placeholders until the owner supplies them.
ACADEMY_ADDRESS=[ADDRESS LINE]
ACADEMY_PHONE=[PHONE]
ACADEMY_UPI_ID=[YOUR UPI ID]
ACADEMY_BANK_NAME=[BANK NAME]
ACADEMY_ACCOUNT_NUMBER=[ACCOUNT NUMBER]
ACADEMY_IFSC=[IFSC]
ACADEMY_ACCOUNT_NAME=Science Academy

# WhatsApp fee reminders (a day before each due date) through Meta's WhatsApp
# Cloud API. Optional: without them parents still get the in-app reminder.
# Template (Utility, approved in WhatsApp Manager) with 3 values:
#   {{1}} student name, {{2}} amount, {{3}} due date
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FEE_TEMPLATE=fee_due_tomorrow
WHATSAPP_TEMPLATE_LANG=en

# Test login for the testing group (optional, temporary). Listed accounts log in
# with this shared six-digit code instead of an emailed code, until the date
# (India time). Never works for Admin. Every such login is marked in the
# activity log. Remove these three to switch it off.
TEST_LOGIN_CODE=
TEST_LOGIN_UNTIL=
TEST_LOGIN_ACCOUNTS=
