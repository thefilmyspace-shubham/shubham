# Supabase (Project Settings -> API). Create the project with the new
# Science Academy email, region Mumbai (ap-south-1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in emails and notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMS OTP through MSG91 (DLT registered sender + approved OTP template).
# Template text must contain the variable ##otp##.
# Leave empty in development: the code is then printed in the server log.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Claude API key (console.anthropic.com -> API keys): AI marksheet check and AI assistant.
ANTHROPIC_API_KEY=

# Bills by email (Resend, resend.com). From address on a verified domain,
# e.g. "Science Academy <bills@scienceacademy.in>".
RESEND_API_KEY=
BILL_FROM_EMAIL=

# Random long string; Vercel sends it with every cron call.
CRON_SECRET=

# Printed on every bill. Placeholders until the owner supplies them.
ACADEMY_ADDRESS=[ADDRESS LINE]
ACADEMY_PHONE=[PHONE]
ACADEMY_UPI_ID=[YOUR UPI ID]
ACADEMY_BANK_NAME=[BANK NAME]
ACADEMY_ACCOUNT_NUMBER=[ACCOUNT NUMBER]
ACADEMY_IFSC=[IFSC]
ACADEMY_ACCOUNT_NAME=Science Academy
